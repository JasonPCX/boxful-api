# Configuracion del Servidor
NODE_ENV=development
PORT=5000

# Autenticacion JWT
JWT_SECRET_KEY=your_jwt_secret_key_here


# String de conexion a MongoDB (formato: mongodb://usuario:password@host:puerto/nombre_base_datos?authSource=admin)
MONGODB_URI=mongodb://admin:password@localhost:27017/boxful?authSource=admin
DB_SYNCHRONIZE=true


# Credenciales para el contenedor de MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password

# Credenciales para el contenedor de Mongo Express
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=password
